# Local development values. On Railway, set these as service variables instead.
DATABASE_URL=postgresql://onepublish:onepublish@localhost:5432/onepublish

# uv run python scripts/gen_secrets.py             -> TOKEN_ENC_KEY, SESSION_SECRET
# uv run python scripts/gen_secrets.py --password  -> ADMIN_PASSWORD_HASH
TOKEN_ENC_KEY=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
# Local http only; keep true (the default) anywhere with HTTPS.
COOKIE_SECURE=false

# TikTok developer portal -> your app -> Sandbox -> credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a redirect URI registered in the portal. Local testing needs an HTTPS tunnel
# (e.g. cloudflared) pointing at the web app: https://<tunnel>/api/tiktok/callback
TIKTOK_REDIRECT_URI=
TIKTOK_USE_PKCE=true
PUBLIC_WEB_URL=http://localhost:3000

STAGING_DIR=./.data/staging
STAGING_CAP_GB=5
YTDLP_COOKIES_PATH=./.data/cookies.txt
POT_PROVIDER_URL=http://localhost:4416
# base64 of a Netscape cookies.txt from a throwaway YouTube account (optional locally)
YTDLP_COOKIES_B64=
YTDLP_PROXY=
LOG_LEVEL=INFO
