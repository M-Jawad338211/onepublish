{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/backend/**"]
  },
  "deploy": {
    "startCommand": "bin/start-worker",
    "numReplicas": 1,
    "drainingSeconds": 90,
    "restartPolicyType": "ALWAYS"
  }
}
